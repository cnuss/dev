# Copy to .env in this directory to override. All optional.

# The image to confine. Anything with a shell works; Debian/Ubuntu bases also
# get the CA installed into the system trust store.
SANDBOX_IMAGE=cnuss/dev

# Base images for the two support containers.
SANDBOX_MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.2.3
SANDBOX_ALPINE_IMAGE=alpine:3.24

# Ports the proxy is willing to CONNECT to (space or comma separated).
SANDBOX_ALLOWED_PORTS=443

# Set to 1 to allow plain-HTTP proxying instead of answering 405.
SANDBOX_ALLOW_PLAIN_HTTP=0

# CA identity and lifetime.
SANDBOX_CA_CN=dev-sandbox egress proxy CA
SANDBOX_CA_DAYS=3650

# uid the mitmproxy image runs as; the CA private key is chowned to it.
SANDBOX_PROXY_UID=1000
