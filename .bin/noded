#!/usr/bin/env bash
# Shell into the underlying node host from the debug sidecar.
#
# On flex nodes the container shares the host's network namespace but not its
# PID or mount namespaces: kubelet and containerd run inside a systemd-nspawn
# machine (kube1) and pods run under that, so `nsenter -t 1` lands in kube1
# rather than on the EC2 host. ssh to the host sshd over the shared netns is
# the only container -> host path, which is what this wraps.
#
# Credentials, in priority order (first configured one wins):
#
#   1. A certificate and key you supply    (NODED_CERT_FILE + NODED_KEY_FILE)
#   2. A certificate minted per session    (NODED_CA_URL, via step-ca)
#   3. A bare private key                  (NODED_KEY or a key at NODED_KEY_FILE)
#   4. Self-provisioned CA via /etc/ssh    (NODED_PROVISION) — the fallback
#
# Self-provision is intentionally last so it can be baked on as an image default
# without shadowing a configured CA or key: it is used only when nothing else is
# supplied. It needs no external CA or Secret, just a writable hostPath mount of
# the node's /etc/ssh (see provision_via_etc_ssh). It and step-ca are preferred —
# the node trusts only a CA public key, the keypair is generated in the pod and
# never leaves it, the certificate expires on its own, and the image ships nothing.
#
# Environment:
#   NODED_USER          login user                (default ubuntu)
#   NODED_HOST          target host               (default 127.0.0.1)
#   NODED_PORT          target port               (default 22)
#   NODED_PRINCIPAL     certificate principal     (default $NODED_USER)
#
#   NODED_PROVISION     mint a CA in-pod and publish trust to a hostPath /etc/ssh
#   NODED_ETC_SSH       node /etc/ssh mount point (default /etc/ssh)
#
#   NODED_CA_URL        step-ca URL; enables certificate mode
#   NODED_CA_ROOT       CA root certificate file  (default /keys/ca.crt)
#   NODED_CA_PROVISIONER  step-ca provisioner name
#   NODED_CA_TOKEN_FILE k8s service account token used to authenticate to
#                          the CA (default the pod's projected SA token)
#   NODED_CERT_VALIDITY certificate lifetime      (default 10m)
#
#   NODED_HOST_CA_FILE  host CA public key; when set, host identity is
#   NODED_HOST_CA       verified against it instead of trust-on-first-use
#
#   NODED_CERT_FILE     pre-minted certificate
#   NODED_KEY_FILE      private key path          (default /keys/id_ed25519)
#   NODED_KEY           private key material, preferred over the file
#
#   NODED_DRY_RUN       print the ssh command instead of running it
#
# Extra arguments are passed to ssh as a remote command; with none you get an
# interactive shell. Usable as a container command, so `command: ["noded"]`
# plus `kubectl attach` drops straight onto the host.
set -euo pipefail

user="${NODED_USER:-ubuntu}"
host="${NODED_HOST:-127.0.0.1}"
port="${NODED_PORT:-22}"
principal="${NODED_PRINCIPAL:-$user}"
key_file="${NODED_KEY_FILE:-/keys/id_ed25519}"
cert_file="${NODED_CERT_FILE:-}"

# Everything transient — generated keys, minted certificates, known_hosts —
# lives here and is removed on exit.
workdir="$(umask 077; mktemp -d)"
published_ca=
published_conf=
cleanup() {
    rm -rf "$workdir"
    # Self-provisioned CA trust is best-effort revoked so a stopped debug pod
    # doesn't leave the node trusting a CA. The private half is ephemeral (it
    # lived only in $workdir), so a residue after SIGKILL trusts a key nobody
    # holds — inert, and overwritten by the next pod.
    [ -n "$published_conf" ] && rm -f "$published_conf" 2>/dev/null || true
    [ -n "$published_ca" ] && rm -f "$published_ca" 2>/dev/null || true
}
trap cleanup EXIT
# k8s sends SIGTERM then SIGKILL after the grace period; run cleanup on TERM/INT
# via the EXIT trap so a graceful stop revokes the published trust.
trap 'exit 143' TERM
trap 'exit 130' INT

# When noded is the container's PID1 for `kubectl attach`, exiting on a
# misconfiguration would CrashLoopBackOff the sidecar. NODED_KEEPALIVE holds
# the container up instead, so it stays attachable and shows the reason. Nothing
# is left connected to the node. Retrying means restarting the pod once fixed.
hold_or_exit() {
    local code="$1"
    if [ -n "${NODED_KEEPALIVE:-}" ]; then
        echo "noded: NODED_KEEPALIVE set; holding the container up. Fix the above and restart the pod." >&2
        cleanup
        exec sleep infinity
    fi
    exit "$code"
}

die() {
    for line in "$@"; do
        echo "noded: $line" >&2
    done
    hold_or_exit 1
}

# Secret volumes mount read-only at mode 0444, which ssh rejects as an
# unprotected private key, and chmod cannot fix a read-only mount. Copy to a
# 0600 file in the workdir instead.
stage_private_file() {
    local src="$1" dest="$workdir/$2"
    cat "$src" > "$dest"
    chmod 0600 "$dest"
    printf '%s' "$dest"
}

mint_certificate() {
    local ca_url="$1"
    local ca_root="${NODED_CA_ROOT:-/keys/ca.crt}"
    local token_file="${NODED_CA_TOKEN_FILE:-/var/run/secrets/kubernetes.io/serviceaccount/token}"
    local validity="${NODED_CERT_VALIDITY:-10m}"
    local key_id="${HOSTNAME:-noded}"

    [ -n "${NODED_CA_PROVISIONER:-}" ] ||
        die "NODED_CA_URL is set but NODED_CA_PROVISIONER is not" \
            "set it to the step-ca provisioner that issues user certificates"
    [ -r "$ca_root" ] ||
        die "CA root certificate not readable at ${ca_root}" \
            "mount it there or set NODED_CA_ROOT"
    [ -r "$token_file" ] ||
        die "no service account token at ${token_file}" \
            "set NODED_CA_TOKEN_FILE, or give the pod a projected SA token"

    # step writes <key>, <key>.pub and <key>-cert.pub next to the key path.
    step ssh certificate \
        --ca-url "$ca_url" \
        --root "$ca_root" \
        --provisioner "$NODED_CA_PROVISIONER" \
        --k8ssa-token-path "$token_file" \
        --principal "$principal" \
        --not-after "$validity" \
        --kty OKP --curve Ed25519 \
        --no-password --insecure --force --no-agent \
        "$key_id" "$workdir/id_ed25519" >&2

    key_file="$workdir/id_ed25519"
    cert_file="$workdir/id_ed25519-cert.pub"
}

# Self-provision: mint a throwaway CA in the pod, publish its public half into
# the node's /etc/ssh (hostPath-mounted here) so the socket-activated sshd trusts
# it on the next connection, then self-sign a short-lived client certificate.
# No CA, Secret, or cloud-init needed — but it requires a writable hostPath mount
# of the node's /etc/ssh, which only works because Ubuntu serves ssh via
# ssh.socket (a fresh sshd per connection re-reads sshd_config.d, so no reload
# has to be signalled to a host process the container can't see).
provision_via_etc_ssh() {
    local etc_ssh="${NODED_ETC_SSH:-/etc/ssh}"
    local validity="${NODED_CERT_VALIDITY:-10m}"
    local key_id="${HOSTNAME:-noded}"
    local ca_pub="$etc_ssh/flex_debug_user_ca.pub"
    local conf="$etc_ssh/sshd_config.d/50-flex-debug.conf"

    [ -d "$etc_ssh/sshd_config.d" ] ||
        die "no ${etc_ssh}/sshd_config.d — hostPath-mount the node's /etc/ssh read-write" \
            "and the host sshd_config must Include sshd_config.d/*.conf (Ubuntu default)"
    # Probe with a real write rather than [ -w ]: this runs as root, which
    # bypasses permission bits, and a read-only bind mount only refuses at
    # write time (EROFS) regardless of the mode shown.
    local probe="$etc_ssh/sshd_config.d/.noded-write-test.$$"
    if ! (: > "$probe") 2>/dev/null; then
        die "${etc_ssh}/sshd_config.d is not writable" \
            "the hostPath mount must be read-write for self-provisioning"
    fi
    rm -f "$probe"

    ssh-keygen -q -t ed25519 -N '' -f "$workdir/user_ca" -C flex-debug-user-ca

    # Stable filenames: a restart replaces the trust rather than accumulating it.
    install -m 0644 "$workdir/user_ca.pub" "$ca_pub"
    published_ca="$ca_pub"
    printf '# managed by noded self-provisioning; removed on graceful stop\nTrustedUserCAKeys %s\n' \
        "$ca_pub" > "$conf"
    published_conf="$conf"
    echo "noded: published runtime CA trust to ${conf}" >&2

    ssh-keygen -q -t ed25519 -N '' -f "$workdir/id" -C flex-debug-client
    ssh-keygen -q -s "$workdir/user_ca" -I "$key_id" -n "$principal" -V "+$validity" \
        "$workdir/id.pub"

    key_file="$workdir/id"
    cert_file="$workdir/id-cert.pub"
}

# Explicit credentials win; self-provisioning is the last-resort default so it
# can be baked on as an image ENV without shadowing a configured CA or key.
if [ -n "$cert_file" ]; then
    [ -r "$cert_file" ] || die "certificate not readable at ${cert_file}"
    [ -r "$key_file" ] || die "NODED_CERT_FILE is set but no key at ${key_file}"
    cert_file="$(stage_private_file "$cert_file" cert.pub)"
    key_file="$(stage_private_file "$key_file" id)"
elif [ -n "${NODED_CA_URL:-}" ]; then
    mint_certificate "$NODED_CA_URL"
elif [ -n "${NODED_KEY:-}" ]; then
    printf '%s\n' "$NODED_KEY" > "$workdir/id"
    chmod 0600 "$workdir/id"
    key_file="$workdir/id"
elif [ -r "$key_file" ]; then
    key_file="$(stage_private_file "$key_file" id)"
elif [ -n "${NODED_PROVISION:-}" ]; then
    provision_via_etc_ssh
else
    die "no credentials available" \
        "self-provision: set NODED_PROVISION=1 with the node's /etc/ssh hostPath-mounted" \
        "certificate mode: set NODED_CA_URL and NODED_CA_PROVISIONER" \
        "key mode: mount a Secret at ${key_file}, or set NODED_KEY"
fi

ssh_opts=(
    -o ServerAliveInterval=30
    -o IdentitiesOnly=yes
    -o IdentityAgent=none
)

# A host CA lets the client verify the node rather than trusting whatever key
# answers first. Without one, fall back to trust-on-first-use.
host_ca=
if [ -n "${NODED_HOST_CA_FILE:-}" ]; then
    [ -r "$NODED_HOST_CA_FILE" ] || die "host CA not readable at ${NODED_HOST_CA_FILE}"
    host_ca="$(cat "$NODED_HOST_CA_FILE")"
elif [ -n "${NODED_HOST_CA:-}" ]; then
    host_ca="$NODED_HOST_CA"
fi

if [ -n "$host_ca" ]; then
    printf '@cert-authority * %s\n' "$host_ca" > "$workdir/known_hosts"
    ssh_opts+=(
        -o "UserKnownHostsFile=$workdir/known_hosts"
        -o StrictHostKeyChecking=yes
    )
else
    ssh_opts+=(-o StrictHostKeyChecking=accept-new)
fi

if [ -n "$cert_file" ]; then
    ssh_opts+=(-o "CertificateFile=$cert_file")
fi

set -- -tt "${ssh_opts[@]}" -i "$key_file" -p "$port" "${user}@${host}" "$@"

if [ -n "${NODED_DRY_RUN:-}" ]; then
    printf 'ssh'
    printf ' %q' "$@"
    printf '\n'
    exit 0
fi

# Deliberately not exec: the workdir holds private key material and the EXIT
# trap is what removes it. exec would replace this shell and leak it.
set +e
ssh "$@"
rc=$?
set -e

# rc 255 is an ssh-level failure — connection refused, auth rejected, host key
# mismatch — i.e. no session ever started. As PID1 that would crash-loop, so
# under keepalive hold instead. Any other rc means a session ran and ended;
# exit with it so `restartPolicy: Always` recycles the sidecar for a fresh one.
if [ "$rc" -eq 255 ]; then
    hold_or_exit "$rc"
fi
exit "$rc"
