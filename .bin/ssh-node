#!/usr/bin/env bash
# Shell into the underlying node host from the debug sidecar.
#
# On flex nodes the container shares the host's network namespace but not its
# PID or mount namespaces: kubelet and containerd run inside a systemd-nspawn
# machine (kube1) and pods run under that, so `nsenter -t 1` lands in kube1
# rather than on the EC2 host. ssh to the host sshd over the shared netns is
# the only container -> host path, which is what this wraps.
#
# Credentials, in priority order:
#
#   1. A certificate and key you supply    (NODE_SSH_CERT_FILE + NODE_SSH_KEY_FILE)
#   2. A certificate minted per session    (NODE_SSH_CA_URL, via step-ca)
#   3. A bare private key                  (NODE_SSH_KEY_FILE or NODE_SSH_KEY)
#
# Mode 2 is preferred: the node trusts only the CA public key, the keypair is
# generated inside the pod and never leaves it, and the certificate expires on
# its own. Nothing durable is stored and no key material ships in this image.
#
# Environment:
#   NODE_SSH_USER          login user                (default ubuntu)
#   NODE_SSH_HOST          target host               (default 127.0.0.1)
#   NODE_SSH_PORT          target port               (default 22)
#   NODE_SSH_PRINCIPAL     certificate principal     (default $NODE_SSH_USER)
#
#   NODE_SSH_CA_URL        step-ca URL; enables certificate mode
#   NODE_SSH_CA_ROOT       CA root certificate file  (default /keys/ca.crt)
#   NODE_SSH_CA_PROVISIONER  step-ca provisioner name
#   NODE_SSH_CA_TOKEN_FILE k8s service account token used to authenticate to
#                          the CA (default the pod's projected SA token)
#   NODE_SSH_CERT_VALIDITY certificate lifetime      (default 10m)
#
#   NODE_SSH_HOST_CA_FILE  host CA public key; when set, host identity is
#   NODE_SSH_HOST_CA       verified against it instead of trust-on-first-use
#
#   NODE_SSH_CERT_FILE     pre-minted certificate
#   NODE_SSH_KEY_FILE      private key path          (default /keys/id_ed25519)
#   NODE_SSH_KEY           private key material, preferred over the file
#
#   NODE_SSH_DRY_RUN       print the ssh command instead of running it
#
# Extra arguments are passed to ssh as a remote command; with none you get an
# interactive shell. Usable as a container command, so `command: ["ssh-node"]`
# plus `kubectl attach` drops straight onto the host.
set -euo pipefail

user="${NODE_SSH_USER:-ubuntu}"
host="${NODE_SSH_HOST:-127.0.0.1}"
port="${NODE_SSH_PORT:-22}"
principal="${NODE_SSH_PRINCIPAL:-$user}"
key_file="${NODE_SSH_KEY_FILE:-/keys/id_ed25519}"
cert_file="${NODE_SSH_CERT_FILE:-}"

# Everything transient — generated keys, minted certificates, known_hosts —
# lives here and is removed on exit.
workdir="$(umask 077; mktemp -d)"
cleanup() { rm -rf "$workdir"; }
trap cleanup EXIT

die() {
    for line in "$@"; do
        echo "ssh-node: $line" >&2
    done
    exit 1
}

# Secret volumes mount read-only at mode 0444, which ssh rejects as an
# unprotected private key, and chmod cannot fix a read-only mount. Copy to a
# 0600 file in the workdir instead.
stage_private_file() {
    local src="$1" dest="$workdir/$2"
    cat "$src" > "$dest"
    chmod 0600 "$dest"
    printf '%s' "$dest"
}

mint_certificate() {
    local ca_url="$1"
    local ca_root="${NODE_SSH_CA_ROOT:-/keys/ca.crt}"
    local token_file="${NODE_SSH_CA_TOKEN_FILE:-/var/run/secrets/kubernetes.io/serviceaccount/token}"
    local validity="${NODE_SSH_CERT_VALIDITY:-10m}"
    local key_id="${HOSTNAME:-ssh-node}"

    [ -n "${NODE_SSH_CA_PROVISIONER:-}" ] ||
        die "NODE_SSH_CA_URL is set but NODE_SSH_CA_PROVISIONER is not" \
            "set it to the step-ca provisioner that issues user certificates"
    [ -r "$ca_root" ] ||
        die "CA root certificate not readable at ${ca_root}" \
            "mount it there or set NODE_SSH_CA_ROOT"
    [ -r "$token_file" ] ||
        die "no service account token at ${token_file}" \
            "set NODE_SSH_CA_TOKEN_FILE, or give the pod a projected SA token"

    # step writes <key>, <key>.pub and <key>-cert.pub next to the key path.
    step ssh certificate \
        --ca-url "$ca_url" \
        --root "$ca_root" \
        --provisioner "$NODE_SSH_CA_PROVISIONER" \
        --k8ssa-token-path "$token_file" \
        --principal "$principal" \
        --not-after "$validity" \
        --kty OKP --curve Ed25519 \
        --no-password --insecure --force --no-agent \
        "$key_id" "$workdir/id_ed25519" >&2

    key_file="$workdir/id_ed25519"
    cert_file="$workdir/id_ed25519-cert.pub"
}

if [ -n "$cert_file" ]; then
    [ -r "$cert_file" ] || die "certificate not readable at ${cert_file}"
    [ -r "$key_file" ] || die "NODE_SSH_CERT_FILE is set but no key at ${key_file}"
    cert_file="$(stage_private_file "$cert_file" cert.pub)"
    key_file="$(stage_private_file "$key_file" id)"
elif [ -n "${NODE_SSH_CA_URL:-}" ]; then
    mint_certificate "$NODE_SSH_CA_URL"
elif [ -n "${NODE_SSH_KEY:-}" ]; then
    printf '%s\n' "$NODE_SSH_KEY" > "$workdir/id"
    chmod 0600 "$workdir/id"
    key_file="$workdir/id"
elif [ -r "$key_file" ]; then
    key_file="$(stage_private_file "$key_file" id)"
else
    die "no credentials available" \
        "certificate mode: set NODE_SSH_CA_URL and NODE_SSH_CA_PROVISIONER" \
        "key mode: mount a Secret at ${key_file}, or set NODE_SSH_KEY"
fi

ssh_opts=(
    -o ServerAliveInterval=30
    -o IdentitiesOnly=yes
    -o IdentityAgent=none
)

# A host CA lets the client verify the node rather than trusting whatever key
# answers first. Without one, fall back to trust-on-first-use.
host_ca=
if [ -n "${NODE_SSH_HOST_CA_FILE:-}" ]; then
    [ -r "$NODE_SSH_HOST_CA_FILE" ] || die "host CA not readable at ${NODE_SSH_HOST_CA_FILE}"
    host_ca="$(cat "$NODE_SSH_HOST_CA_FILE")"
elif [ -n "${NODE_SSH_HOST_CA:-}" ]; then
    host_ca="$NODE_SSH_HOST_CA"
fi

if [ -n "$host_ca" ]; then
    printf '@cert-authority * %s\n' "$host_ca" > "$workdir/known_hosts"
    ssh_opts+=(
        -o "UserKnownHostsFile=$workdir/known_hosts"
        -o StrictHostKeyChecking=yes
    )
else
    ssh_opts+=(-o StrictHostKeyChecking=accept-new)
fi

if [ -n "$cert_file" ]; then
    ssh_opts+=(-o "CertificateFile=$cert_file")
fi

set -- -tt "${ssh_opts[@]}" -i "$key_file" -p "$port" "${user}@${host}" "$@"

if [ -n "${NODE_SSH_DRY_RUN:-}" ]; then
    printf 'ssh'
    printf ' %q' "$@"
    printf '\n'
    exit 0
fi

# Deliberately not exec: the workdir holds private key material and the EXIT
# trap is what removes it. exec would replace this shell and leak it.
ssh "$@"
