# Copy to .env to override. All optional. Used by docker-compose.yml.

# Passed through to the root Dockerfile's BASE_IMAGE arg.
SANDBOX_BASE_IMAGE=ubuntu:26.04

# Base image for the proxy container.
SANDBOX_MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.2.3

# Ports the explicit proxy is willing to CONNECT to (space or comma separated).
SANDBOX_ALLOWED_PORTS=443

# Transparent capture of :80/:443/:53. Set to 0 to run explicit-proxy-only;
# proxy-unaware clients then fail to connect instead of being intercepted.
SANDBOX_TRANSPARENT=1

# Set to 1 to allow plain-HTTP proxying instead of answering 405.
SANDBOX_ALLOW_PLAIN_HTTP=0

# Fallback owner for mitmproxy's confdir, used only if the image has no
# `mitmproxy` user.
SANDBOX_PROXY_UID=1000
